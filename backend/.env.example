# =========================================================
# Azure AI Foundry Project
# =========================================================
# Found in: Azure AI Foundry Portal -> Your Project -> Overview -> "Project connection string"
# Format (newer SDK): https://<your-resource>.services.ai.azure.com/api/projects/<project-name>
AZURE_PROJECT_CONNECTION_STRING=https://<your-ai-foundry-resource>.services.ai.azure.com/api/projects/<your-project-name>

# =========================================================
# Azure OpenAI (model deployment used by the agents)
# =========================================================
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-azure-openai-key>
AZURE_OPENAI_MODEL=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# =========================================================
# Optional: Azure AI Search (RAG for Medical Information Agent)
# =========================================================
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_KEY=
AZURE_AI_SEARCH_INDEX=

# =========================================================
# Optional: Azure Blob Storage (persisting uploaded reports)
# =========================================================
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=medical-reports

# =========================================================
# Optional: Azure Document Intelligence (better PDF/scan parsing)
# =========================================================
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=

# =========================================================
# App settings
# =========================================================
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
CONVERSATION_STORE_PATH=./data/conversations.json
